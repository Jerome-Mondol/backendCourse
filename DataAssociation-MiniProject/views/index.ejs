<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-3xl mb-3" >Create User</h3>
        <form method="post" action="/register">
            <input class="px-3 py-2 outline-none bg-transparent rounded-lg border-2 border-zinc-800" type="text" placeholder="name" name="name">
            <input class="px-3 py-2 outline-none bg-transparent rounded-lg border-2 border-zinc-800" type="text" placeholder="username" name="username">
            <input class="px-3 py-2 outline-none bg-transparent rounded-lg border-2 border-zinc-800" type="password" placeholder="password" name="password">
            <input class="px-3 py-2 outline-none bg-transparent rounded-lg border-2 border-zinc-800" type="email" placeholder="email" name="email">
            <input class="px-3 py-2 outline-none bg-transparent rounded-lg border-2 border-zinc-800" type="number" placeholder="age" name="age">

            <input type="submit" class="px-3 py-2 bg-blue-500 rounded-lg cursor-pointer" value="Create Account">
        </form>
    </div>
</body>
</html>